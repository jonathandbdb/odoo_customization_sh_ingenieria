<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Layout interno para Cotización SH: define header y footer corridos -->
    <template id="sh_so_layout">
        <t t-if="not o" t-set="o" t-value="doc"/>

        <!-- Encabezado superior corrido en cada página -->
        <div class="header" style="font-size: 9px; color: rgb(0, 0, 70);">
            <div>
                Archivo: Cotizacion <span t-field="o.name"/>
                <t t-if="o.partner_id"> <span t-field="o.partner_id.name"/></t>
                <t t-if="o.sh_first_section_name"> <span t-out="o.sh_first_section_name"/></t>
                <t t-if="o.date_order"> <span t-out="o._get_date_short(o.date_order)"/></t>
            </div>
            <div>
                <span t-field="o.company_id.street"/>
                <t t-if="o.company_id.city">, <span t-field="o.company_id.city"/></t>
                <t t-if="o.company_id.state_id"> [<span t-field="o.company_id.state_id.code"/>]</t>
                <t t-if="o.company_id.phone"> - Tel.: <span t-field="o.company_id.phone"/></t>
            </div>
            <div>Correo: <span t-field="o.company_id.email"/></div>
            <div>
                Página <span class="page"/> de <span class="topage"/>
            </div>
        </div>

        <!-- Footer vacío para reservar espacio -->
        <div class="footer"/>

        <div class="article"
             t-att-data-oe-model="o and o._name"
             t-att-data-oe-id="o and o.id"
             t-att-data-oe-lang="o and o.env.context.get('lang')">
            <t t-out="0"/>
        </div>
    </template>

    <!-- Reporte principal de Cotización SH -->
    <template id="report_sh_sale_order_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="sh_sale_order_report.sh_so_layout">
                    <div class="page" style="font-size: 11px; color: #000;">

                        <!-- Encabezado: título + fecha (izq) y logo (der) -->
                        <div class="row mb-3">
                            <div class="col-7">
                                <div style="font-size: 16px; font-weight: bold; color: #2E86C1;">
                                    Cotizacion N. <span t-field="o.name"/>
                                </div>
                                <div style="font-size: 10px; margin-top: 2px;">
                                    <span t-out="o._get_date_format(o.date_order)"/>
                                </div>
                            </div>
                            <div class="col-5 text-end">
                                <img t-if="o.company_id.logo"
                                     t-att-src="image_data_uri(o.company_id.logo)"
                                     style="height: 55px;"
                                     alt="Logo"/>
                            </div>
                        </div>

                        <!-- Datos del cliente: incluye empresa padre cuando el partner es un contacto hijo -->
                        <div style="font-size: 16px; font-weight: bold; margin-bottom: 2px; color: #2E86C1;">
                            <t t-if="o.partner_id.parent_id">
                                <span t-field="o.partner_id.parent_id.name"/>, <span t-field="o.partner_id.name"/>
                            </t>
                            <t t-else="">
                                <span t-field="o.partner_id.name"/>
                            </t>
                        </div>
                        <div style="font-size: 10px; line-height: 1.4;">
                            <div t-if="o.partner_id.street"><span t-field="o.partner_id.street"/></div>
                            <div t-if="o.partner_id.street2"><span t-field="o.partner_id.street2"/></div>
                            <div t-if="o.partner_id.phone">Tel: <span t-field="o.partner_id.phone"/></div>
                            <div t-if="o.partner_id.email"><span t-field="o.partner_id.email"/></div>
                        </div>

                        <!-- Fila: título central + totales -->
                        <div class="row mt-3 mb-2">
                            <div class="col-7 text-center" style="align-self: center;">
                                <div t-if="o.sh_first_note_name" style="font-size: 20px; font-weight: bold; color: #2E86C1;">
                                    <span t-out="o.sh_first_note_name"/>
                                </div>
                            </div>
                            <div class="col-5">
                                <div class="row">
                                    <div class="col-6 text-end"><strong>Subtotal</strong></div>
                                    <div class="col-6 text-end">
                                        <span t-field="o.amount_untaxed"
                                              t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-6 text-end"><strong>IVA</strong></div>
                                    <div class="col-6 text-end">
                                        <span t-field="o.amount_tax"
                                              t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-6 text-end"><strong>TOTAL</strong></div>
                                    <div class="col-6 text-end">
                                        <strong>
                                            <span t-field="o.amount_total"
                                                  t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                        </strong>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Tabla de líneas -->
                        <table class="table table-sm" style="font-size: 10px;">
                            <thead>
                                <tr>
                                    <th style="width: 12%;">Ref.</th>
                                    <th style="width: 43%;">Descripción</th>
                                    <th class="text-center" style="width: 8%;">Und.</th>
                                    <th class="text-center" style="width: 8%;">Cant.</th>
                                    <th class="text-end" style="width: 14%;">Vr. Unitario</th>
                                    <th class="text-end" style="width: 15%;">Vr. Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="blocks" t-value="o._get_section_blocks()"/>
                                <t t-set="first_note_id" t-value="o._get_first_note_line_id()"/>
                                <t t-foreach="blocks" t-as="block">
                                    <t t-if="block['section']">
                                        <tr>
                                            <td colspan="5" style="font-size: 13px; font-weight: bold; color: #89B300;">
                                                <span t-out="block['section'].name"/>
                                            </td>
                                            <td class="text-end" style="font-size: 11px; color: #89B300;">
                                                <span style="margin-right: 8px;">Vr. Capítulo</span>
                                                <strong>
                                                    <span t-out="block['subtotal']"
                                                          t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                                </strong>
                                            </td>
                                        </tr>
                                    </t>
                                    <t t-foreach="block['lines']" t-as="line">
                                        <t t-if="line.display_type == 'line_note'">
                                            <t t-if="line.id != first_note_id">
                                                <tr>
                                                    <td colspan="6" style="font-style: italic; color: #555;">
                                                        <span t-field="line.name"/>
                                                    </td>
                                                </tr>
                                            </t>
                                        </t>
                                        <t t-elif="not line.display_type">
                                            <tr>
                                                <td><em><span t-out="line.product_id.default_code or ''"/></em></td>
                                                <td><em><span t-field="line.name"/></em></td>
                                                <td class="text-center"><em><span t-field="line.product_uom_id"/></em></td>
                                                <td class="text-center"><em><span t-out="'{:,.2f}'.format(line.product_uom_qty)"/></em></td>
                                                <td class="text-end">
                                                    <em><span t-field="line.price_unit"
                                                              t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></em>
                                                </td>
                                                <td class="text-end">
                                                    <em><span t-field="line.price_subtotal"
                                                              t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></em>
                                                </td>
                                            </tr>
                                        </t>
                                    </t>
                                </t>
                            </tbody>
                        </table>

                        <!-- Separador con azul corporativo -->
                        <hr style="border: none; border-top: 2px solid #2E86C1; margin: 20px 0 10px 0;"/>

                        <!-- Condiciones comerciales + firma vendedor -->
                        <div class="row" style="font-size: 10px;">
                            <div class="col-7">
                                <div style="font-size: 12px; font-weight: bold; color: #003366; margin-bottom: 6px;">
                                    Condiciones Comerciales
                                </div>
                                <div class="row">
                                    <div class="col-5">Plazos de pago</div>
                                    <div class="col-7" style="border-bottom: 1px solid #999;">
                                        <span t-field="o.payment_term_id"/>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-5">Tiempo de Entrega</div>
                                    <div class="col-7" style="border-bottom: 1px solid #999;">
                                        <t t-set="delivery_days" t-value="o._get_days_between(o.date_order, o.commitment_date)"/>
                                        <t t-if="delivery_days"><span t-out="delivery_days"/> días</t>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-5">Validez de la Oferta</div>
                                    <div class="col-7" style="border-bottom: 1px solid #999;">
                                        <t t-set="validity_days" t-value="o._get_days_between(o.date_order, o.validity_date)"/>
                                        <t t-if="validity_days"><span t-out="validity_days"/> días</t>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-5">Garantía</div>
                                    <div class="col-7" style="border-bottom: 1px solid #999;">
                                        <t t-if="o.sh_warranty"><span t-out="o.sh_warranty"/></t>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-5">Sitio de entrega</div>
                                    <div class="col-7" style="border-bottom: 1px solid #999;">
                                        <t t-if="o.partner_shipping_id and o.partner_shipping_id.city">
                                            <span t-field="o.partner_shipping_id.city"/>
                                            <t t-if="o.partner_shipping_id.state_id">, <span t-field="o.partner_shipping_id.state_id.name"/></t>
                                        </t>
                                        <t t-elif="o.partner_id.city">
                                            <span t-field="o.partner_id.city"/>
                                        </t>
                                    </div>
                                </div>
                            </div>
                            <div class="col-5 text-center">
                                <div style="border-top: 1px solid #000; margin: 40px 20px 4px 20px;"/>
                                <div t-if="o.user_id" style="font-weight: bold;">
                                    <span t-field="o.user_id.name"/>
                                </div>
                                <div t-if="o.user_id.partner_id.phone">
                                    Tel.: <span t-field="o.user_id.partner_id.phone"/>
                                </div>
                                <div t-if="o.user_id.partner_id.email">
                                    Correo: <span t-field="o.user_id.partner_id.email"/>
                                </div>
                            </div>
                        </div>

                        <!-- Observaciones -->
                        <div t-if="o.note" style="margin-top: 16px; font-size: 10px;">
                            <div style="font-size: 12px; font-weight: bold; color: #003366; margin-bottom: 4px;">
                                Observaciones
                            </div>
                            <div style="text-align: justify;">
                                <span t-field="o.note"/>
                            </div>
                        </div>

                        <!-- Aspectos Técnicos -->
                        <div t-if="o.sh_technical_aspects" style="margin-top: 16px; font-size: 10px;">
                            <div style="font-size: 12px; font-weight: bold; color: #003366; margin-bottom: 4px;">
                                Aspectos Técnicos
                            </div>
                            <div style="text-align: justify;">
                                <span t-field="o.sh_technical_aspects"/>
                            </div>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
