<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Formato de papel personalizado para reporte de factura de compra SH -->
    <record id="paperformat_sh_invoice" model="report.paperformat">
        <field name="name">SH Invoice Format</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">35</field>
        <field name="margin_bottom">28</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_spacing">30</field>
        <field name="header_line" eval="False"/>
        <field name="dpi">90</field>
    </record>

    <!-- Vincular el paper format al reporte estándar de facturas con pagos -->
    <record id="account.account_invoices_without_payment" model="ir.actions.report">
        <field name="paperformat_id" ref="paperformat_sh_invoice"/>
    </record>

    <record id="account.account_invoices" model="ir.actions.report">
        <field name="paperformat_id" ref="paperformat_sh_invoice"/>
    </record>

</odoo>
