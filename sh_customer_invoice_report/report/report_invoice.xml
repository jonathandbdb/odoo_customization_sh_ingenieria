<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Reporte personalizado de Factura de Venta / Nota Crédito (primary=True = copia independiente) -->
    <template id="report_invoice_document_sh" inherit_id="account.report_invoice_document" primary="True">
        <xpath expr="//t[@t-call='web.external_layout']" position="replace">
            <t t-call="sh_customer_invoice_report.internal_layout_invoice">
                <div class="page" style="font-size: 12px;">
                    <!-- Solo aplica para facturas de venta y notas crédito -->
                    <t t-if="o.move_type in ('out_invoice', 'out_refund')">

                        <!-- FIX 1: Empresa (sin borde) + Cliente (con tabla bordeada) + Fechas debajo del cliente (FIX 2) -->
                        <table style="width: 100%; margin-bottom: 1px;">
                            <tr>
                                <!-- Empresa emisora: texto plano SIN borde ni recuadro -->
                                <td style="width: 40%; vertical-align: top; font-size: 11px; padding-right: 10px;">
                                    <div>NIT: <span t-field="o.company_id.vat"/></div>
                                    <div>Direccion: <span t-field="o.company_id.street"/></div>
                                    <div>Ciudad: <span t-field="o.company_id.city"/>, D.C. - <span t-field="o.company_id.state_id"/></div>
                                    <div>Teléfono: <span t-field="o.company_id.phone"/></div>
                                    <div>Correo Electronico: <span t-field="o.company_id.email"/></div>
                                    <div><span t-field="o.company_id.website"/></div>
                                </td>
                                <!-- Cliente: texto plano SIN borde (FIX 1 v10) -->
                                <td style="width: 60%; vertical-align: top; font-size: 11px;">
                                    <div style="margin-bottom: 2px;"><strong>CLIENTE: <span t-field="o.partner_id.name"/></strong></div>
                                    <div style="margin-bottom: 2px;"><strong>NIT: <span t-field="o.partner_id.vat_num"/></strong></div>
                                    <div style="margin-bottom: 2px;"><strong>DIRECCION:</strong> <span t-field="o.partner_id.street"/></div>
                                    <div style="margin-bottom: 3px;">
                                        <strong>CIUDAD:</strong>
                                        <t t-if="o.partner_id.city_id"><span t-field="o.partner_id.city_id.name"/></t>
                                        <t t-else=""><span t-field="o.partner_id.city"/></t>
                                        &#160;&#160;<strong>TELÉFONO:</strong> <span t-field="o.partner_id.phone"/>
                                    </div>
                                    <!-- FIX 2: Fechas y forma de pago debajo del cliente, NO full width -->
                                    <table style="width: 100%; border-collapse: collapse; font-size: 12px; margin-top: -1px;">
                                        <tr style="background-color: #003366; color: white;">
                                            <th style="border: 1px solid black; padding: 3px; text-align: center;"><strong>FECHA EXPEDICIÓN</strong></th>
                                            <th style="border: 1px solid black; padding: 3px; text-align: center;"><strong>FECHA VENCIMIENTO</strong></th>
                                            <th style="border: 1px solid black; padding: 3px; text-align: center;"><strong>FORMA DE PAGO</strong></th>
                                        </tr>
                                        <tr>
                                            <td style="border: 1px solid black; padding: 3px; text-align: center;">
                                                <span t-field="o.invoice_date"/>
                                            </td>
                                            <td style="border: 1px solid black; padding: 3px; text-align: center;">
                                                <span t-field="o.invoice_date_due"/>
                                            </td>
                                            <td style="border: 1px solid black; padding: 3px; text-align: center;">
                                                <span t-field="o.invoice_payment_term_id"/>
                                            </td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>
                        </table>

                        <!-- FIX 3: Observaciones con menos margen -->
                        <div t-if="o.narration" style="font-size: 11px; margin-bottom: 1px;">
                            <strong>Observaciones: </strong><span t-field="o.narration"/>
                        </div>

                        <!-- Secciones exclusivas para Nota Crédito -->
                        <t t-if="o.move_type == 'out_refund'">
                            <!-- Documentos Relacionados -->
                            <table t-if="o.reversed_entry_id" style="width: 100%; border-collapse: collapse; font-size: 10px; margin-bottom: 3px;">
                                <tr style="background-color: #003366; color: white;">
                                    <th colspan="5" style="border: 1px solid black; padding: 4px; text-align: center; font-weight: bold;">DOCUMENTOS RELACIONADOS</th>
                                </tr>
                                <tr>
                                    <td style="border: 1px solid black; padding: 3px; font-weight: bold; width: 10%;">No.:</td>
                                    <td style="border: 1px solid black; padding: 3px; width: 25%;"><span t-field="o.reversed_entry_id.name"/></td>
                                    <td style="border: 1px solid black; padding: 3px; font-weight: bold; width: 8%;">Tipo:</td>
                                    <td style="border: 1px solid black; padding: 3px; width: 37%;">Factura</td>
                                    <td style="border: 1px solid black; padding: 3px; width: 20%;">
                                        <strong>Fecha:</strong> <span t-field="o.reversed_entry_id.invoice_date"/>
                                    </td>
                                </tr>
                                <tr t-if="o.reversed_entry_id.l10n_co_edi_cufe_cude_ref">
                                    <td style="border: 1px solid black; padding: 3px; font-weight: bold;">CUFE / CUDE:</td>
                                    <td colspan="4" style="border: 1px solid black; padding: 3px; font-size: 8px; word-break: break-all;">
                                        <span t-field="o.reversed_entry_id.l10n_co_edi_cufe_cude_ref"/>
                                    </td>
                                </tr>
                            </table>

                            <!-- Conceptos de la Nota Crédito -->
                            <table style="width: 100%; border-collapse: collapse; font-size: 10px; margin-bottom: 3px;">
                                <tr style="background-color: #003366; color: white;">
                                    <th colspan="2" style="border: 1px solid black; padding: 4px; text-align: center; font-weight: bold;">CONCEPTOS DE LA NOTA</th>
                                </tr>
                                <tr style="background-color: #e0e0e0;">
                                    <th style="border: 1px solid black; padding: 3px; width: 40%;">Código</th>
                                    <th style="border: 1px solid black; padding: 3px; width: 60%;">Descripción</th>
                                </tr>
                                <tr>
                                    <td style="border: 1px solid black; padding: 3px;">
                                        <t t-if="o.l10n_co_edi_description_code_credit">
                                            <span t-out="dict(o._fields['l10n_co_edi_description_code_credit'].selection).get(o.l10n_co_edi_description_code_credit, '')"/>
                                        </t>
                                    </td>
                                    <td style="border: 1px solid black; padding: 3px;">
                                        <t t-if="o.narration"><span t-field="o.narration"/></t>
                                        <t t-elif="o.ref"><span t-field="o.ref"/></t>
                                    </td>
                                </tr>
                            </table>
                        </t>

                        <!-- Secciones exclusivas para Nota Débito -->
                        <t t-if="o.move_type == 'out_invoice' and o.journal_id.l10n_co_edi_debit_note">
                            <!-- Documentos Relacionados (referencia a factura original) -->
                            <table t-if="o.debit_origin_id" style="width: 100%; border-collapse: collapse; font-size: 10px; margin-bottom: 3px;">
                                <tr style="background-color: #003366; color: white;">
                                    <th colspan="5" style="border: 1px solid black; padding: 4px; text-align: center; font-weight: bold;">DOCUMENTOS RELACIONADOS</th>
                                </tr>
                                <tr>
                                    <td style="border: 1px solid black; padding: 3px; font-weight: bold; width: 10%;">No.:</td>
                                    <td style="border: 1px solid black; padding: 3px; width: 25%;"><span t-field="o.debit_origin_id.name"/></td>
                                    <td style="border: 1px solid black; padding: 3px; font-weight: bold; width: 8%;">Tipo:</td>
                                    <td style="border: 1px solid black; padding: 3px; width: 37%;">Factura</td>
                                    <td style="border: 1px solid black; padding: 3px; width: 20%;">
                                        <strong>Fecha:</strong> <span t-field="o.debit_origin_id.invoice_date"/>
                                    </td>
                                </tr>
                                <tr t-if="o.debit_origin_id.l10n_co_edi_cufe_cude_ref">
                                    <td style="border: 1px solid black; padding: 3px; font-weight: bold;">CUFE / CUDE:</td>
                                    <td colspan="4" style="border: 1px solid black; padding: 3px; font-size: 8px; word-break: break-all;">
                                        <span t-field="o.debit_origin_id.l10n_co_edi_cufe_cude_ref"/>
                                    </td>
                                </tr>
                            </table>

                            <!-- Conceptos de la Nota Débito -->
                            <table style="width: 100%; border-collapse: collapse; font-size: 10px; margin-bottom: 3px;">
                                <tr style="background-color: #003366; color: white;">
                                    <th colspan="2" style="border: 1px solid black; padding: 4px; text-align: center; font-weight: bold;">CONCEPTOS DE LA NOTA</th>
                                </tr>
                                <tr style="background-color: #e0e0e0;">
                                    <th style="border: 1px solid black; padding: 3px; width: 40%;">Código</th>
                                    <th style="border: 1px solid black; padding: 3px; width: 60%;">Descripción</th>
                                </tr>
                                <tr>
                                    <td style="border: 1px solid black; padding: 3px;">
                                        <t t-if="o.l10n_co_edi_description_code_debit">
                                            <span t-out="dict(o._fields['l10n_co_edi_description_code_debit'].selection).get(o.l10n_co_edi_description_code_debit, '')"/>
                                        </t>
                                    </td>
                                    <td style="border: 1px solid black; padding: 3px;">
                                        <t t-if="o.narration"><span t-field="o.narration"/></t>
                                        <t t-elif="o.ref"><span t-field="o.ref"/></t>
                                    </td>
                                </tr>
                            </table>
                        </t>

                        <!-- FIX 8: Tabla de líneas con columnas FTE e ICA agregadas -->
                        <table style="width: 100%; border-collapse: collapse; font-size: 10px; margin-bottom: 1px;">
                            <thead>
                                <tr style="background-color: #003366; color: white; font-weight: bold;">
                                    <th style="border: 1px solid black; padding: 2px; text-align: center; width: 4%;">Item</th>
                                    <th style="border: 1px solid black; padding: 2px; text-align: center; width: 8%;">Código</th>
                                    <th style="border: 1px solid black; padding: 2px; text-align: left; width: 28%;">Descripción</th>
                                    <th style="border: 1px solid black; padding: 2px; text-align: center; width: 7%;">UM</th>
                                    <th style="border: 1px solid black; padding: 2px; text-align: center; width: 6%;">Cant.</th>
                                    <th style="border: 1px solid black; padding: 2px; text-align: right; width: 11%;">Precio U.</th>
                                    <th style="border: 1px solid black; padding: 2px; text-align: center; width: 5%;">IVA%</th>
                                    <th style="border: 1px solid black; padding: 2px; text-align: center; width: 5%;">FTE%</th>
                                    <th style="border: 1px solid black; padding: 2px; text-align: center; width: 5%;">ICA%</th>
                                    <th style="border: 1px solid black; padding: 2px; text-align: right; width: 14%;">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="line_num" t-value="0"/>
                                <t t-foreach="o.invoice_line_ids.sorted(key=lambda l: l.sequence)" t-as="line">
                                    <t t-if="line.display_type == 'product'">
                                        <t t-set="line_num" t-value="line_num + 1"/>
                                        <!-- Calcular IVA%, FTE%, ICA% por línea -->
                                        <t t-set="iva_perc" t-value="0"/>
                                        <t t-set="fte_perc" t-value="0"/>
                                        <t t-set="ica_perc" t-value="0"/>
                                        <t t-foreach="line.tax_ids" t-as="tax">
                                            <t t-if="tax.amount and tax.amount_type == 'percent' and tax.amount &gt; 0">
                                                <t t-set="iva_perc" t-value="int(tax.amount)"/>
                                            </t>
                                            <t t-if="tax.amount and tax.amount &lt; 0 and 'fte' in (tax.name or '').lower()">
                                                <t t-set="fte_perc" t-value="abs(tax.amount)"/>
                                            </t>
                                            <t t-if="tax.amount and tax.amount &lt; 0 and 'ica' in (tax.name or '').lower()">
                                                <t t-set="ica_perc" t-value="abs(tax.amount)"/>
                                            </t>
                                        </t>
                                        <tr>
                                            <td style="border: 1px solid black; padding: 2px; text-align: center;"><span t-out="line_num"/></td>
                                            <td style="border: 1px solid black; padding: 2px; text-align: center;">
                                                <span t-out="line.product_id.default_code or ''"/>
                                            </td>
                                            <td style="border: 1px solid black; padding: 2px;"><span t-field="line.name"/></td>
                                            <td style="border: 1px solid black; padding: 2px; text-align: center;">
                                                <span t-field="line.product_uom_id"/>
                                            </td>
                                            <td style="border: 1px solid black; padding: 2px; text-align: center;">
                                                <span t-field="line.quantity"/>
                                            </td>
                                            <td style="border: 1px solid black; padding: 2px; text-align: right;">
                                                <span t-field="line.price_unit" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                            </td>
                                            <td style="border: 1px solid black; padding: 2px; text-align: center;">
                                                <span t-out="iva_perc"/>
                                            </td>
                                            <td style="border: 1px solid black; padding: 2px; text-align: center;">
                                                <t t-if="fte_perc"><span t-out="fte_perc"/></t>
                                            </td>
                                            <td style="border: 1px solid black; padding: 2px; text-align: center;">
                                                <t t-if="ica_perc"><span t-out="ica_perc"/></t>
                                            </td>
                                            <td style="border: 1px solid black; padding: 2px; text-align: right;">
                                                <span t-field="line.price_subtotal" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                            </td>
                                        </tr>
                                    </t>
                                    <t t-if="line.display_type == 'line_section'">
                                        <tr>
                                            <td colspan="10" style="border: 1px solid black; padding: 2px;"><strong><span t-field="line.name"/></strong></td>
                                        </tr>
                                    </t>
                                    <t t-if="line.display_type == 'line_note'">
                                        <tr>
                                            <td colspan="10" style="border: 1px solid black; padding: 2px; color: #6c757d;"><span t-field="line.name"/></td>
                                        </tr>
                                    </t>
                                </t>
                            </tbody>
                        </table>

                        <!-- Totales, retenciones e información legal (tabla única para evitar gaps) -->
                        <table style="width: 100%; font-size: 11px;">
                            <tr>
                                <td style="width: 50%; vertical-align: top; padding-right: 10px;">
                                    <div>Total líneas o ítems: <span t-out="line_num"/></div>
                                    <div style="margin-top: 2px;">
                                        <strong>Valor en Letras</strong><br/>
                                        <span t-field="o.total_letras" style="text-transform: uppercase;"/>
                                    </div>
                                    <!-- Orden de compra recuadrado (solo facturas) -->
                                    <div t-if="o.ref and o.move_type == 'out_invoice' and not o.journal_id.l10n_co_edi_debit_note" style="margin-top: 2px; border: 1px solid black; padding: 3px;">
                                        <strong>ORDEN DE COMPRA: </strong>
                                        <span t-field="o.ref"/>
                                    </div>
                                    <!-- Remisión recuadrado (solo facturas) -->
                                    <div t-if="o.invoice_origin and o.move_type == 'out_invoice' and not o.journal_id.l10n_co_edi_debit_note" style="margin-top: 2px; border: 1px solid black; padding: 3px;">
                                        <strong>REMISIÓN: </strong>
                                        <span t-field="o.invoice_origin"/>
                                    </div>
                                    <!-- Texto legal art. 774 (solo facturas) -->
                                    <div t-if="o.move_type == 'out_invoice' and not o.journal_id.l10n_co_edi_debit_note" style="border: 1px solid black; padding: 4px; margin-top: 2px; font-size: 10px;">
                                        <div>Esta factura se asimila en todos sus efectos a la letra de cambio según artículo 774 del Código de Comercio.El incumplimiento en el pago de esta facturaen la fecha de vencimiento generará interés de mora a la tasa mas alta autorizada por la Ley</div>
                                    </div>
                                    <!-- Favor consignar cuentas recuadrado (facturas y notas débito, NO notas crédito) -->
                                    <div t-if="o.move_type != 'out_refund'" style="border: 1px solid black; padding: 4px; margin-top: 2px; font-size: 10px;">
                                        <strong>Favor consignar en las cuentas:</strong><br/>
                                        <t t-foreach="o.company_id.partner_id.bank_ids" t-as="bank">
                                            <span t-out="bank.bank_id.name or ''"/> Cta Corriente No. <span t-out="bank.acc_number"/><br/>
                                        </t>
                                    </div>
                                    <!-- Garantías (facturas y notas débito, NO notas crédito) -->
                                    <div t-if="o.company_id.website and o.move_type != 'out_refund'" style="border: 1px solid black; padding: 4px; margin-top: 2px; font-size: 10px;">
                                        <strong>Garantías: </strong><span t-field="o.company_id.website"/>
                                    </div>
                                </td>
                                <td style="width: 50%; vertical-align: top;">
                                    <table style="width: 100%; border-collapse: collapse; font-size: 12px;">
                                        <tr>
                                            <th style="border: 1px solid black; padding: 3px;"><strong>SUBTOTAL</strong></th>
                                            <td style="border: 1px solid black; padding: 3px; text-align: right;">
                                                <span t-field="o.amount_untaxed" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                            </td>
                                        </tr>
                                        <!-- Solo IVA (impuestos positivos), sin retenciones -->
                                        <t t-set="iva_total" t-value="0"/>
                                        <t t-if="o.tax_totals">
                                            <t t-foreach="o.tax_totals.get('subtotals', [])" t-as="subtotal">
                                                <t t-foreach="subtotal.get('tax_groups', [])" t-as="tax_group">
                                                    <t t-if="tax_group.get('tax_amount_currency', 0) &gt;= 0">
                                                        <t t-set="iva_total" t-value="iva_total + tax_group.get('tax_amount_currency', 0)"/>
                                                        <tr>
                                                            <th style="border: 1px solid black; padding: 3px;"><strong><span t-out="tax_group.get('group_name', 'IVA')"/></strong></th>
                                                            <td style="border: 1px solid black; padding: 3px; text-align: right;">
                                                                <span t-out="tax_group.get('tax_amount_currency', 0)" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                                            </td>
                                                        </tr>
                                                    </t>
                                                </t>
                                            </t>
                                        </t>
                                        <tr>
                                            <th style="border: 1px solid black; padding: 3px;"><strong>TOTAL DE LA OPERACIÓN</strong></th>
                                            <td style="border: 1px solid black; padding: 3px; text-align: right;">
                                                <strong>
                                                    <span t-out="o.amount_untaxed + iva_total" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                                </strong>
                                            </td>
                                        </tr>
                                        <!-- Retenciones calculadas desde líneas impositivas -->
                                        <t t-set="retefuente" t-value="0"/>
                                        <t t-set="reteiva" t-value="0"/>
                                        <t t-set="reteica" t-value="0"/>
                                        <t t-foreach="o.line_ids.filtered(lambda l: l.tax_line_id)" t-as="tline">
                                            <t t-if="tline.tax_line_id.amount &lt; 0 and 'fte' in (tline.tax_line_id.name or '').lower()">
                                                <t t-set="retefuente" t-value="retefuente + abs(tline.amount_currency)"/>
                                            </t>
                                            <t t-if="tline.tax_line_id.amount &lt; 0 and ('rteiva' in (tline.tax_line_id.name or '').lower() or 'rtevat' in (tline.tax_line_id.name or '').lower())">
                                                <t t-set="reteiva" t-value="reteiva + abs(tline.amount_currency)"/>
                                            </t>
                                            <t t-if="tline.tax_line_id.amount &lt; 0 and 'ica' in (tline.tax_line_id.name or '').lower()">
                                                <t t-set="reteica" t-value="reteica + abs(tline.amount_currency)"/>
                                            </t>
                                        </t>
                                        <tr t-if="retefuente">
                                            <th style="border: 1px solid black; padding: 3px;"><strong>RETEFUENTE</strong></th>
                                            <td style="border: 1px solid black; padding: 3px; text-align: right;">
                                                <span t-out="retefuente" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <th style="border: 1px solid black; padding: 3px;"><strong>RETEIVA</strong></th>
                                            <td style="border: 1px solid black; padding: 3px; text-align: right;">
                                                <span t-out="reteiva" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                            </td>
                                        </tr>
                                        <tr t-if="reteica">
                                            <th style="border: 1px solid black; padding: 3px;"><strong>RETEICA</strong></th>
                                            <td style="border: 1px solid black; padding: 3px; text-align: right;">
                                                <span t-out="reteica" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <th style="border: 1px solid black; padding: 3px; background-color: #e0e0e0;">
                                                <strong>
                                                    <t t-if="o.move_type == 'out_refund'">TOTAL NOTA CRÉDITO</t>
                                                    <t t-elif="o.journal_id.l10n_co_edi_debit_note">TOTAL NOTA DÉBITO</t>
                                                    <t t-else="">TOTAL FACTURA</t>
                                                </strong>
                                            </th>
                                            <td style="border: 1px solid black; padding: 3px; text-align: right; background-color: #e0e0e0;">
                                                <strong>
                                                    <span t-out="o.amount_untaxed + iva_total - retefuente - reteiva - reteica" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                                </strong>
                                            </td>
                                        </tr>
                                    </table>
                                    <!-- Representación Gráfica header -->
                                    <div style="border: 1px solid black; padding: 4px; text-align: center; margin-top: 3px; font-size: 10px;">
                                        <strong>
                                            <t t-if="o.move_type == 'out_refund'">Representación Gráfica de la Nota de Crédito Electrónica</t>
                                            <t t-elif="o.journal_id.l10n_co_edi_debit_note">Representación Gráfica de la Nota de Débito Electrónica</t>
                                            <t t-else="">Representación Gráfica de la Factura de Venta Electrónica</t>
                                        </strong>
                                    </div>
                                    <!-- Obtener valores DIAN (CUFE/QR) -->
                                    <t t-set="dian_values" t-value="o._l10n_co_dian_get_extra_invoice_report_values() if o.l10n_co_edi_cufe_cude_ref else {}"/>
                                    <!-- Fecha/Hora y Medios de pago a la IZQUIERDA, QR a la DERECHA -->
                                    <table style="width: 100%; font-size: 9px; margin-top: 5px;">
                                        <tr>
                                            <td style="vertical-align: top;">
                                                <div>
                                                    <strong>Fecha y Hora de Generación:</strong><br/>
                                                    <span t-field="o.create_date" t-options='{"format": "M/d/yyyy h:mm a"}'/>
                                                </div>
                                                <div style="margin-top: 3px;">
                                                    <strong>Medios de pago:</strong><br/>
                                                    <span>Instrumento no definido</span>
                                                </div>
                                            </td>
                                            <td style="vertical-align: top; text-align: right; width: 130px;">
                                                <!-- QR Code desde DIAN -->
                                                <t t-if="dian_values.get('barcode_src')">
                                                    <img t-att-src="dian_values.get('barcode_src')" style="width: 110px; height: 110px;" alt="QR"/>
                                                </t>
                                                <t t-else="">
                                                    <div style="width: 100px; height: 100px; border: 1px solid #ccc; margin: 0 0 0 auto; line-height: 100px; color: #999; font-size: 10px; text-align: center;">QR Code</div>
                                                </t>
                                            </td>
                                        </tr>
                                    </table>
                                    <!-- CUFE/CUDE -->
                                    <div t-if="dian_values.get('identifier')" style="font-size: 8px; margin-top: 3px; word-break: break-all;">
                                        <strong><t t-out="o.l10n_co_dian_identifier_type.upper() if o.l10n_co_dian_identifier_type else 'CUFE'"/>: </strong>
                                        <span t-out="dian_values.get('identifier')"/>
                                    </div>
                                </td>
                            </tr>
                        </table>

                        <!-- Datos de pagos realizados (si aplica) -->
                        <div t-if="print_with_payments">
                            <t t-set="payments_vals" t-value="o.sudo().invoice_payments_widget and o.sudo().invoice_payments_widget.get('content', [])"/>
                            <div t-if="payments_vals" style="margin-top: 10px;">
                                <strong>Pagos realizados:</strong>
                                <table style="width: 100%; border-collapse: collapse; font-size: 10px; margin-top: 3px;">
                                    <tr>
                                        <th style="border: 1px solid black; padding: 3px;">Fecha</th>
                                        <th style="border: 1px solid black; padding: 3px;">Referencia</th>
                                        <th style="border: 1px solid black; padding: 3px; text-align: right;">Monto</th>
                                    </tr>
                                    <tr t-foreach="payments_vals" t-as="payment">
                                        <td style="border: 1px solid black; padding: 3px;"><span t-out="payment.get('date', '')"/></td>
                                        <td style="border: 1px solid black; padding: 3px;"><span t-out="payment.get('ref', '')"/></td>
                                        <td style="border: 1px solid black; padding: 3px; text-align: right;"><span t-out="payment.get('amount', 0)" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                                    </tr>
                                </table>
                                <div style="margin-top: 3px;">
                                    <strong>Saldo pendiente: </strong>
                                    <span t-field="o.amount_residual" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                </div>
                            </div>
                        </div>
                    </t>

                    <!-- Para facturas de proveedor / otros tipos, usar el layout estándar -->
                    <t t-if="o.move_type not in ('out_invoice', 'out_refund')">
                        <t t-call="web.external_layout">
                            <t t-set="o" t-value="o.with_context(lang=lang)"/>
                            <div class="page">
                                <h2>
                                    <span t-if="o.move_type == 'in_invoice'">Factura de proveedor</span>
                                    <span t-if="o.move_type == 'in_refund'">Nota Crédito Proveedor</span>
                                    <span t-if="o.name != '/'" t-field="o.name"/>
                                </h2>
                                <table style="width: 100%; margin-top: 10px; margin-bottom: 10px; font-size: 11px;">
                                    <tr>
                                        <td t-if="o.invoice_date" style="width: 25%;">
                                            <strong>Fecha:</strong><br/>
                                            <span t-field="o.invoice_date"/>
                                        </td>
                                        <td t-if="o.invoice_origin" style="width: 25%;">
                                            <strong>Origen:</strong><br/>
                                            <span t-field="o.invoice_origin"/>
                                        </td>
                                        <td t-if="o.ref" style="width: 25%;">
                                            <strong>Referencia:</strong><br/>
                                            <span t-field="o.ref"/>
                                        </td>
                                    </tr>
                                </table>
                                <table style="width: 100%; border-collapse: collapse; font-size: 11px;">
                                    <thead>
                                        <tr>
                                            <th style="border: 1px solid black; padding: 3px;">Descripción</th>
                                            <th style="border: 1px solid black; padding: 3px; text-align: right;">Cantidad</th>
                                            <th style="border: 1px solid black; padding: 3px; text-align: right;">Precio Unitario</th>
                                            <th style="border: 1px solid black; padding: 3px;">Impuestos</th>
                                            <th style="border: 1px solid black; padding: 3px; text-align: right;">Importe</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="o.invoice_line_ids.sorted(key=lambda l: l.sequence)" t-as="line">
                                            <t t-if="line.display_type == 'product'">
                                                <tr>
                                                    <td style="border: 1px solid black; padding: 3px;"><span t-field="line.name"/></td>
                                                    <td style="border: 1px solid black; padding: 3px; text-align: right;"><span t-field="line.quantity"/> <span t-field="line.product_uom_id"/></td>
                                                    <td style="border: 1px solid black; padding: 3px; text-align: right;"><span t-field="line.price_unit"/></td>
                                                    <td style="border: 1px solid black; padding: 3px;"><span t-out="', '.join(line.tax_ids.mapped('name'))"/></td>
                                                    <td style="border: 1px solid black; padding: 3px; text-align: right;"><span t-field="line.price_subtotal"/></td>
                                                </tr>
                                            </t>
                                        </t>
                                    </tbody>
                                </table>
                                <table style="width: 50%; margin-left: 50%; border-collapse: collapse; font-size: 11px; margin-top: 5px;">
                                    <tr>
                                        <th style="padding: 3px;">Monto Libre de Impuestos</th>
                                        <td style="padding: 3px; text-align: right;"><span t-field="o.amount_untaxed"/></td>
                                    </tr>
                                    <tr>
                                        <th style="padding: 3px;">Impuestos</th>
                                        <td style="padding: 3px; text-align: right;"><span t-field="o.amount_tax"/></td>
                                    </tr>
                                    <tr style="border-top: 2px solid black;">
                                        <th style="padding: 3px;"><strong>Total</strong></th>
                                        <td style="padding: 3px; text-align: right;"><strong><span t-field="o.amount_total"/></strong></td>
                                    </tr>
                                </table>
                                <div t-if="o.invoice_payment_term_id" style="margin-top: 5px;">
                                    <strong>Plazo de pago: </strong><span t-field="o.invoice_payment_term_id"/>
                                </div>
                            </div>
                        </t>
                    </t>
                </div>
            </t>
        </xpath>
    </template>

    <!-- Dispatch: agregar nuestro template en el reporte de factura -->
    <template id="report_invoice_sh_dispatch" inherit_id="account.report_invoice">
        <xpath expr='//t[@t-call="account.report_invoice_document"]' position="after">
            <t t-elif="o._get_name_invoice_report() == 'sh_customer_invoice_report.report_invoice_document_sh'"
               t-call="sh_customer_invoice_report.report_invoice_document_sh"
               t-lang="lang"/>
        </xpath>
    </template>

</odoo>
