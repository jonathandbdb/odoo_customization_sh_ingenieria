<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Pie de página corporativo SH Ingeniería -->
    <template id="reportes_footer">
        <div class="footer" style="color: rgb(0, 0, 70); text-align: center; font-size: 11px;">
            <hr style="border-top: 1px solid #28a745; margin: 2px 0;"/>
            <div>
                <span t-field="o.company_id.street"/>
                - <span t-field="o.company_id.state_id"/>
                • Tel. <span t-field="o.company_id.phone"/>
            </div>
            <span t-field="o.company_id.email"/>
            • <span t-field="o.company_id.website"/>
        </div>
    </template>

    <!-- Cabecera para Factura de Venta Electrónica (dentro del cuerpo del artículo) -->
    <template id="reportes_header_invoice">
        <style>
            .sh-header-table,
            .sh-header-table tr,
            .sh-header-table td,
            .sh-header-table th {
                border: 0 none !important;
                outline: 0 !important;
                box-shadow: none !important;
            }
        </style>
        <table class="sh-header-table" cellpadding="0" cellspacing="0" style="width: 100%; margin-bottom: 12px;">
            <tr>
                <!-- Logo + texto fiscal -->
                <td style="width: 55%; vertical-align: top; padding-right: 15px;">
                    <img t-if="o.company_id.logo" t-att-src="image_data_uri(o.company_id.logo)" style="height: 70px; margin-bottom: 6px;" alt="Logo"/>
                    <div style="font-size: 10px; color: rgb(0, 0, 70);">
                        Somos Responsables de IVA, No somos Grandes Contribuyentes Ni Autorretenedores
                    </div>
                </td>
                <!-- Tipo de documento + N° + Resolución DIAN -->
                <td style="width: 45%; vertical-align: top;">
                    <div style="background-color: #003366; color: white; padding: 8px 10px; font-size: 12px; font-weight: bold; text-align: center;">
                        <t t-if="o.move_type == 'out_invoice' and o.journal_id.l10n_co_edi_debit_note">Nota Débito Electrónica De Venta</t>
                        <t t-elif="o.move_type == 'out_invoice'">Factura Electrónica De Venta</t>
                        <t t-elif="o.move_type == 'out_refund'">Nota Crédito</t>
                        <t t-else="">Documento</t>
                    </div>
                    <div style="padding: 8px 10px; font-size: 17px; font-weight: bold; text-align: center; border: 1px solid #003366; border-top: none;">
                        No. <span t-field="o.name"/>
                    </div>
                    <!-- Texto resolución DIAN + Actividades Económicas (justificado) -->
                    <div style="font-size: 10px; margin-top: 6px; line-height: 1.4; text-align: justify;">
                        <t t-if="o.journal_id.l10n_co_edi_dian_authorization_number and o.move_type == 'out_invoice'">
                            <div>Documento Oficial de Autorización de Numeración Facturación Electrónica DIAN
                                No. <span t-field="o.journal_id.l10n_co_edi_dian_authorization_number"/>
                                del <span t-field="o.journal_id.l10n_co_edi_dian_authorization_date"/>
                                que habilita desde <span t-out="o.journal_id.l10n_co_edi_min_range_number"/>
                                hasta <span t-out="o.journal_id.l10n_co_edi_max_range_number"/>
                                Vence el <span t-field="o.journal_id.l10n_co_edi_dian_authorization_end_date"/>.</div>
                        </t>
                        <div t-if="o.company_id.l10n_co_edi_header_actividad_economica" style="margin-top: 2px;">
                            <span t-field="o.company_id.l10n_co_edi_header_actividad_economica"/>
                        </div>
                    </div>
                </td>
            </tr>
        </table>
    </template>

    <!-- Layout interno para Factura de Venta -->
    <template id="internal_layout_invoice">
        <t t-if="not o" t-set="o" t-value="doc"/>
        <t t-if="not company">
            <t t-if="company_id">
                <t t-set="company" t-value="company_id"/>
            </t>
            <t t-elif="o and 'company_id' in o and o.company_id.sudo()">
                <t t-set="company" t-value="o.company_id.sudo()"/>
            </t>
            <t t-else="">
                <t t-set="company" t-value="res_company"/>
            </t>
        </t>
        <div class="article" style="padding-top: 0; margin-top: 0; border: 0 none !important;" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id" t-att-data-oe-lang="o and o.env.context.get('lang')">
            <t t-call="sh_customer_invoice_report.reportes_header_invoice"/>
            <t t-out="0"/>
        </div>
        <t t-call="sh_customer_invoice_report.reportes_footer"/>
    </template>

</odoo>
