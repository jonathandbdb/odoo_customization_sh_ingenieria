<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Formato de papel para reportes de factura SH sin header estándar Odoo -->
    <record id="paperformat_sh_invoice" model="report.paperformat">
        <field name="name">SH - Factura Sin Header Estándar</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">2</field>
        <field name="margin_bottom">20</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <!-- Asignar el formato al reporte de Factura (con y sin pagos) -->
    <record id="account.account_invoices" model="ir.actions.report">
        <field name="paperformat_id" ref="paperformat_sh_invoice"/>
    </record>
    <record id="account.account_invoices_without_payment" model="ir.actions.report">
        <field name="paperformat_id" ref="paperformat_sh_invoice"/>
    </record>

</odoo>
