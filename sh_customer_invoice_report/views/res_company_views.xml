<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Campo de actividades económicas en el formulario de compañía -->
    <record id="view_company_form_invoice_economic" model="ir.ui.view">
        <field name="name">res.company.form.invoice.economic</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='social_media']" position="inside">
                <field name="invoice_economic_activities"
                       placeholder="Ej: Act Economica 4321 Tarifa 6.9X1000 - Act Economica 3312 Tarifa 9.66X1000&#10;Actividad Economica 4741 Tarifa 11.04X1000"/>
            </xpath>
        </field>
    </record>

</odoo>
