<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Pie de página corporativo SH Ingeniería -->
    <template id="reportes_footer">
        <div class="footer col-12 text-center align-self-center" style="color: rgb(0, 0, 70);">
            <hr class="bg-success"/>
            <div>
                <span t-field="o.company_id.street"/>
                - <span t-field="o.company_id.state_id"/>
                • Tel. <span t-field="o.company_id.phone"/>
                - Cel. <span t-field="o.company_id.mobile"/>
            </div>
            <span t-field="o.company_id.email"/>
            • <span t-field="o.company_id.website"/>
        </div>
    </template>

    <!-- Cabecera para Orden de Compra -->
    <template id="reportes_header">
        <div class="header">
            <div class="row">
                <div class="col-6">
                    <img src="/formatos_sh/static/src/img/logo.png" width="100%"/>
                </div>
                <div class="col-6 text-start ms-5">
                    <div class="text-light">.</div>
                    <div style="font-size: 20px !important;">
                        <strong>ORDEN DE COMPRA No. <span t-field="o.name"/></strong>
                    </div>
                    <div>
                        Documento Externo No. <span t-field="o.origin"/>
                    </div>
                </div>
            </div>
        </div>
    </template>

    <!-- Cabecera para Remisión (Entrega/Recepción) -->
    <template id="reportes_header_2">
        <div class="header">
            <div class="row">
                <div class="col-12 text-center">
                    <img src="/formatos_sh/static/src/img/logo.png" width="50%"/>
                    <div style="font-size: 20px !important; color: rgb(0, 0, 70);">
                        <span>NIT. <span t-field="o.company_id.vat"/></span>
                    </div>
                </div>
            </div>
            <div class="row me-3">
                <div class="col-12 text-end" style="font-size: 20px !important;">
                    <strong>REMISIÓN No. <span t-field="o.name"/></strong>
                </div>
            </div>
        </div>
    </template>

    <!-- Cabecera para Cotización / Orden de Venta -->
    <template id="reportes_header3">
        <div class="header">
            <div class="row" style="font-size: 12px !important;">
                <div class="col-12">
                    <div>Archivo: Cotizacion <span t-field="o.name"/> <span t-field="o.partner_id"/> <span t-out="titulo"/> <span t-field="o.date_order" t-options='{"widget": "date"}'/></div>
                    <div><span t-field="o.company_id.street"/>, <span t-field="o.company_id.state_id"/> - Cel.: <span t-field="o.company_id.mobile"/> -PBX: <span t-field="o.company_id.phone"/></div>
                    <div>Correo: <span t-field="o.company_id.email"/></div>
                    <div>
                        <ul class="list-inline">
                            <li class="list-inline-item">Página <span class="page"/> de <span class="topage"/></li>
                        </ul>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-6">
                    <div class="text-light">.</div>
                    <div class="h4" style="font-size: 15px !important;color: rgb(46, 93, 165);">Cotizacion N.
                        <span t-field="o.name"/>
                    </div>
                    <div class="mt-n2" style="font-size: 12px !important;">
                        <span t-field="o.formatted_write_date"/>
                    </div>
                </div>
                <div class="col-6 text-end pt-3">
                    <div>
                        <img src="/formatos_sh/static/src/img/logo.png" width="252" height="54" alt=""/>
                    </div>
                </div>
            </div>
        </div>
    </template>

    <!-- Cabecera para Factura de Venta Electrónica -->
    <template id="reportes_header_invoice">
        <div class="header">
            <div class="row">
                <div class="col-6">
                    <img src="/formatos_sh/static/src/img/logo.png" width="80%"/>
                    <div class="mt-1" style="font-size: 9px; color: rgb(0, 0, 70);">
                        <div>Somos Responsables de IVA, No somos Grandes Contribuyentes Ni Autorretenedores</div>
                    </div>
                </div>
                <div class="col-6">
                    <table class="table table-sm table-bordered" style="font-size: 10px;">
                        <tr>
                            <td colspan="2" class="text-center">
                                <strong>
                                    <t t-if="o.move_type == 'out_invoice'">Factura Electrónica De Venta No.</t>
                                    <t t-elif="o.move_type == 'out_refund'">Nota Crédito No.</t>
                                    <t t-else="">Documento No.</t>
                                </strong>
                                <br/>
                                <strong style="font-size: 14px;"><span t-field="o.name"/></strong>
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>
    </template>

    <!-- Cabecera para Factura de Proveedor -->
    <template id="reportes_header_vendor_bill">
        <div class="header">
            <div class="row">
                <div class="col-6">
                    <img src="/formatos_sh/static/src/img/logo.png" width="80%"/>
                </div>
            </div>
        </div>
    </template>

    <!-- Layout interno para Orden de Compra (con header de OC y footer corporativo) -->
    <template id="internal_layout">
        <t t-if="not o" t-set="o" t-value="doc"/>
        <t t-if="not company">
            <t t-if="company_id">
                <t t-set="company" t-value="company_id"/>
            </t>
            <t t-elif="o and 'company_id' in o and o.company_id.sudo()">
                <t t-set="company" t-value="o.company_id.sudo()"/>
            </t>
            <t t-else="">
                <t t-set="company" t-value="res_company"/>
            </t>
        </t>
        <div class="article" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id" t-att-data-oe-lang="o and o.env.context.get('lang')">
            <t t-call="formatos_sh.reportes_header"/>
            <t t-out="0"/>
            <t t-call="formatos_sh.reportes_footer"/>
        </div>
    </template>

    <!-- Layout interno para Remisión (con header de remisión y footer corporativo) -->
    <template id="internal_layout2">
        <t t-if="not o" t-set="o" t-value="doc"/>
        <t t-if="not company">
            <t t-if="company_id">
                <t t-set="company" t-value="company_id"/>
            </t>
            <t t-elif="o and 'company_id' in o and o.company_id.sudo()">
                <t t-set="company" t-value="o.company_id.sudo()"/>
            </t>
            <t t-else="">
                <t t-set="company" t-value="res_company"/>
            </t>
        </t>
        <div class="article" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id" t-att-data-oe-lang="o and o.env.context.get('lang')">
            <t t-call="formatos_sh.reportes_header_2"/>
            <t t-out="0"/>
            <t t-call="formatos_sh.reportes_footer"/>
        </div>
    </template>

    <!-- Layout interno para Cotización / Orden de Venta -->
    <template id="internal_layout3">
        <t t-if="not o" t-set="o" t-value="doc"/>
        <t t-if="not company">
            <t t-if="company_id">
                <t t-set="company" t-value="company_id"/>
            </t>
            <t t-elif="o and 'company_id' in o and o.company_id.sudo()">
                <t t-set="company" t-value="o.company_id.sudo()"/>
            </t>
            <t t-else="">
                <t t-set="company" t-value="res_company"/>
            </t>
        </t>
        <t t-set="titulo" t-value="''"/>
        <t t-foreach="doc.order_line" t-as="line">
            <t t-if="line.display_type == 'line_note'">
                <t t-set="titulo" t-value="line.name"/>
            </t>
        </t>
        <div class="article" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id" t-att-data-oe-lang="o and o.env.context.get('lang')">
            <t t-call="formatos_sh.reportes_header3"/>
            <t t-out="0"/>
        </div>
    </template>

    <!-- Layout interno para Factura de Venta -->
    <template id="internal_layout_invoice">
        <t t-if="not o" t-set="o" t-value="doc"/>
        <t t-if="not company">
            <t t-if="company_id">
                <t t-set="company" t-value="company_id"/>
            </t>
            <t t-elif="o and 'company_id' in o and o.company_id.sudo()">
                <t t-set="company" t-value="o.company_id.sudo()"/>
            </t>
            <t t-else="">
                <t t-set="company" t-value="res_company"/>
            </t>
        </t>
        <div class="article" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id" t-att-data-oe-lang="o and o.env.context.get('lang')">
            <t t-call="formatos_sh.reportes_header_invoice"/>
            <t t-out="0"/>
            <t t-call="formatos_sh.reportes_footer"/>
        </div>
    </template>

    <!-- Layout interno para Factura de Proveedor -->
    <template id="internal_layout_vendor_bill">
        <t t-if="not o" t-set="o" t-value="doc"/>
        <t t-if="not company">
            <t t-if="company_id">
                <t t-set="company" t-value="company_id"/>
            </t>
            <t t-elif="o and 'company_id' in o and o.company_id.sudo()">
                <t t-set="company" t-value="o.company_id.sudo()"/>
            </t>
            <t t-else="">
                <t t-set="company" t-value="res_company"/>
            </t>
        </t>
        <div class="article" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id" t-att-data-oe-lang="o and o.env.context.get('lang')">
            <t t-call="formatos_sh.reportes_header_vendor_bill"/>
            <t t-out="0"/>
            <t t-call="formatos_sh.reportes_footer"/>
        </div>
    </template>

</odoo>
