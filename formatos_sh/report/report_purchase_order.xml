<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Reporte personalizado de Orden de Compra - Hereda del documento base de purchase -->
    <template id="report_purchaseorder_document_inherit" inherit_id="purchase.report_purchaseorder_document">
        <xpath expr="//t[@t-call='web.external_layout']" position="replace">
            <t t-call="formatos_sh.internal_layout">
                <div class="page" style="font-size: 12px !important;">
                    <!-- Sección superior: Proveedor y Concepto -->
                    <div class="row">
                        <div class="col-6" style="padding: 0px 5px 0px 15px;">
                            <table class="table table-sm" style="border: 1px solid black; width:100%;">
                                <tr>
                                    <th style="border: 1px solid black; width:25%;">
                                        <strong>PROVEEDOR</strong>
                                    </th>
                                    <td style="border: 1px solid black; width:75%;">
                                        <span t-field="o.partner_id"/>
                                    </td>
                                </tr>
                                <tr>
                                    <th style="border: 1px solid black; width:25%;">
                                        <strong>NIT</strong>
                                    </th>
                                    <td style="border: 1px solid black; width:75%;">
                                        <span t-field="o.partner_id.vat_num"/>
                                    </td>
                                </tr>
                            </table>
                        </div>
                        <div class="col-6" style="padding: 0px 15px 0px 5px;">
                            <table class="table table-sm" style="border: 1px solid white; width:100%;">
                                <tr>
                                    <th style="border: 1px solid black;">
                                        <strong>POR CONCEPTO DE</strong>
                                    </th>
                                </tr>
                                <tr>
                                    <td style="border-right: 1px solid black;border-left: 1px solid black;">
                                        <div>ORDEN DE COMPRA</div>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>

                    <!-- Dirección, Ciudad, Teléfono y campo vacío derecho -->
                    <div class="row mb-1">
                        <div class="col-6" style="padding: 0px 5px 0px 15px;">
                            <table class="table table-sm border-light" style="border: 1px solid white;">
                                <tr>
                                    <th style="border-right: 1px solid black;border-left: 1px solid black;border-bottom: 1px solid black; width:33%;">
                                        <strong>DIRECCIÓN</strong>
                                    </th>
                                    <th style="border-right: 1px solid black;border-left: 1px solid black;border-bottom: 1px solid black; width:33%;">
                                        <strong>CIUDAD</strong>
                                    </th>
                                    <th style="border-right: 1px solid black;border-left: 1px solid black;border-bottom: 1px solid black; width:33%;">
                                        <strong>TELÉFONO</strong>
                                    </th>
                                </tr>
                                <tr>
                                    <td style="border: 1px solid black;">
                                        <span t-field="o.partner_id.street"/>
                                    </td>
                                    <td style="border: 1px solid black;">
                                        <t t-if="o.partner_id.city_id">
                                            <span t-field="o.partner_id.city_id.name"/>
                                        </t>
                                        <t t-else="">
                                            <span t-field="o.partner_id.city"/>
                                        </t>
                                    </td>
                                    <td style="border: 1px solid black;">
                                        <span t-field="o.partner_id.phone"/>
                                    </td>
                                </tr>
                            </table>
                        </div>
                        <div class="col-6" style="padding: 0px 15px 0px 5px;">
                            <table class="table table-sm table-borderless">
                                <tr style="border-left: 1px solid black;border-right: 1px solid black;">
                                    <th class="text-center" style="border-left: 1px solid black;border-right: 1px solid black;">
                                        <span class="text-light">-</span>
                                    </th>
                                </tr>
                                <tr>
                                    <td style="border-left: 1px solid black;border-right: 1px solid black;border-bottom: 1px solid black;">
                                        <span class="text-light">-</span>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>

                    <!-- Fechas, Elaborado por, Forma de pago -->
                    <div class="row mb-1">
                        <div class="col-6" style="padding: 0px 5px 0px 15px;">
                            <table class="table table-sm" style="width:100%;">
                                <tr class="text-center">
                                    <th style="border: 1px solid black;">
                                        <strong>FECHA DEL PEDIDO</strong>
                                    </th>
                                    <th style="border: 1px solid black;">
                                        <strong>FECHA RECEPCIÓN DE COMPRA</strong>
                                    </th>
                                </tr>
                                <tr class="text-center">
                                    <td style="border: 1px solid black;">
                                        <span t-out="o._get_date_format(o.date_approve)"/>
                                    </td>
                                    <td style="border: 1px solid black;">
                                        <span t-out="o._get_date_format(o.date_planned)"/>
                                    </td>
                                </tr>
                            </table>
                        </div>
                        <div class="col-6" style="padding: 0px 15px 0px 5px;">
                            <table class="table table-sm" style="border: 1px solid black; width:100%;">
                                <tr>
                                    <th class="text-center" style="border: 1px solid black;">
                                        <strong>ELABORADO POR</strong>
                                    </th>
                                    <th class="text-center" style="border: 1px solid black;">
                                        <strong>FORMA DE PAGO</strong>
                                    </th>
                                </tr>
                                <tr>
                                    <td style="border: 1px solid black;">
                                        <span t-field="o.user_id"/>
                                    </td>
                                    <td style="border: 1px solid black;">
                                        <span t-field="o.payment_term_id"/>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>

                    <!-- Tabla de líneas de la orden -->
                    <div class="row">
                        <div class="col-12">
                            <table class="table table-sm o_main_table table-borderless" style="border: 1px solid black;">
                                <tr>
                                    <th class="text-center" style="border: 1px solid black;width:44%;">
                                        <strong>Descripción</strong>
                                    </th>
                                    <th class="text-center" style="border: 1px solid black;width:8%;">
                                        <strong>Cantidad</strong>
                                    </th>
                                    <th class="text-center" style="border: 1px solid black;width:8%;">
                                        <strong>U. Medida</strong>
                                    </th>
                                    <th class="text-center" style="border: 1px solid black;width:16%;">
                                        <strong>Valor Unitario</strong>
                                    </th>
                                    <th class="text-center" style="border: 1px solid black;width:7%;">
                                        <strong>IVA</strong>
                                    </th>
                                    <th class="text-center" style="border: 1px solid black;width:17%;">
                                        <strong>Total</strong>
                                    </th>
                                </tr>
                                <t t-if="o.order_line">
                                    <t t-foreach="o.order_line" t-as="line">
                                        <t t-if="not line.display_type">
                                            <tr>
                                                <td style="border-right: 1px solid black;border-left: 1px solid black;">
                                                    <span t-field="line.name"/>
                                                </td>
                                                <td style="border-right: 1px solid black;border-left: 1px solid black;" class="text-end">
                                                    <span t-field="line.product_qty"/>
                                                </td>
                                                <td class="text-center" style="border-right: 1px solid black;border-left: 1px solid black;">
                                                    <span t-field="line.product_uom_id"/>
                                                </td>
                                                <td style="border-right: 1px solid black;border-left: 1px solid black;" class="text-end">
                                                    <span t-field="line.price_unit"/>
                                                </td>
                                                <td class="text-center" style="border-right: 1px solid black;border-left: 1px solid black;">
                                                    <t t-set="tax_perc" t-value="0"/>
                                                    <t t-foreach="line.taxes_id" t-as="tax">
                                                        <t t-if="tax.amount and tax.amount_type == 'percent'">
                                                            <t t-set="tax_perc" t-value="tax.amount / 100.0"/>
                                                        </t>
                                                    </t>
                                                    <span t-out="tax_perc"/>
                                                </td>
                                                <td style="border-right: 1px solid black;border-left: 1px solid black;" class="text-end">
                                                    <span t-field="line.price_subtotal"/>
                                                </td>
                                            </tr>
                                        </t>
                                    </t>
                                </t>
                            </table>
                        </div>
                    </div>

                    <!-- Totales y valor en letras -->
                    <div class="row">
                        <div class="col-6">
                            <div><strong>Valor en letras: </strong></div>
                            <div><span t-field="o.total_letras"/></div>
                        </div>
                        <div class="col-6" style="padding: 0px 14px 0px 18px;">
                            <table class="table table-sm o_main_table" style="border: 1px solid black;">
                                <tr>
                                    <th style="border-right: 1px solid black;border-left: 1px solid black;width:50%;">
                                        <strong>SUBTOTAL</strong>
                                    </th>
                                    <td class="text-end" style="border-right: 1px solid black;border-left: 1px solid black;width:50%;">
                                        <t t-set="subtotal" t-value="0.0"/>
                                        <t t-if="o.order_line">
                                            <t t-foreach="o.order_line" t-as="line">
                                                <t t-if="not line.display_type">
                                                    <t t-set="subtotal" t-value="subtotal + line.product_qty * line.price_unit"/>
                                                </t>
                                            </t>
                                        </t>
                                        <strong>
                                            <span t-out="subtotal" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                        </strong>
                                    </td>
                                </tr>
                                <tr>
                                    <th style="border: 1px solid black;">
                                        <strong>DESCUENTO</strong>
                                    </th>
                                    <td class="text-end" style="border: 1px solid black;">
                                        <t t-set="total_desc" t-value="0.00"/>
                                        <strong>
                                            <t t-if="o.order_line">
                                                <t t-foreach="o.order_line" t-as="line">
                                                    <t t-if="not line.display_type">
                                                        <t t-set="total_desc" t-value="total_desc + (line.price_unit * line.product_qty) - line.price_subtotal"/>
                                                    </t>
                                                </t>
                                            </t>
                                            <span t-out="total_desc" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                        </strong>
                                    </td>
                                </tr>
                                <tr>
                                    <th style="border: 1px solid black;">
                                        <strong>IVA</strong>
                                    </th>
                                    <td class="text-end" style="border: 1px solid black;">
                                        <strong><span t-field="o.amount_tax"/></strong>
                                    </td>
                                </tr>
                                <tr>
                                    <th style="border: 1px solid black;">
                                        <strong>TOTAL DOCUMENTO</strong>
                                    </th>
                                    <td class="text-end" style="border: 1px solid black;">
                                        <strong><span t-field="o.amount_total"/></strong>
                                    </td>
                                </tr>
                            </table>
                            <div class="col-12 text-center align-self-center">
                                <strong>Precios en <span t-field="o.currency_id"/></strong>
                            </div>
                        </div>
                    </div>

                    <!-- Firma -->
                    <div class="d-inline-block">
                        <span>Firma Responsable: </span>
                    </div>
                    <div class="d-inline-flex">
                        <span class="text-light border-bottom border-dark">_____________________________________</span>
                    </div>
                </div>
            </t>
        </xpath>
    </template>

</odoo>
