<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Reporte personalizado de Factura de Venta / Nota Crédito -->
    <template id="report_invoice_document_inherit_sh" inherit_id="account.report_invoice_document">
        <xpath expr="//t[@t-call='web.external_layout']" position="replace">
            <t t-call="formatos_sh.internal_layout_invoice">
                <div class="page" style="font-size: 11px !important;">
                    <!-- Solo aplica para facturas de venta y notas crédito -->
                    <t t-if="o.move_type in ('out_invoice', 'out_refund')">
                        <!-- Información de la empresa emisora y del cliente -->
                        <div class="row mb-2">
                            <div class="col-6" style="font-size: 10px;">
                                <div>NIT: <span t-field="o.company_id.vat"/></div>
                                <div>Direccion: <span t-field="o.company_id.street"/></div>
                                <div>Ciudad: <span t-field="o.company_id.city"/> - <span t-field="o.company_id.state_id"/></div>
                                <div>Teléfono: <span t-field="o.company_id.phone"/></div>
                                <div>Correo Electronico: <span t-field="o.company_id.email"/></div>
                                <div><span t-field="o.company_id.website"/></div>
                            </div>
                            <div class="col-6">
                                <table class="table table-sm table-bordered" style="font-size: 11px;">
                                    <tr>
                                        <th style="width:30%;"><strong>CLIENTE:</strong></th>
                                        <td colspan="3"><strong><span t-field="o.partner_id"/></strong></td>
                                    </tr>
                                    <tr>
                                        <th><strong>NIT:</strong></th>
                                        <td colspan="3"><span t-field="o.partner_id.vat_num"/></td>
                                    </tr>
                                    <tr>
                                        <th><strong>DIRECCION:</strong></th>
                                        <td colspan="3"><span t-field="o.partner_id.street"/></td>
                                    </tr>
                                    <tr>
                                        <th><strong>CIUDAD:</strong></th>
                                        <td>
                                            <t t-if="o.partner_id.city_id">
                                                <span t-field="o.partner_id.city_id.name"/>
                                            </t>
                                            <t t-else="">
                                                <span t-field="o.partner_id.city"/>
                                            </t>
                                        </td>
                                        <th><strong>TELÉFONO:</strong></th>
                                        <td><span t-field="o.partner_id.phone"/></td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- Fechas y forma de pago -->
                        <div class="row mb-2">
                            <div class="col-12">
                                <table class="table table-sm table-bordered text-center" style="font-size: 11px;">
                                    <tr>
                                        <th style="border: 1px solid black;"><strong>FECHA EXPEDICIÓN</strong></th>
                                        <th style="border: 1px solid black;"><strong>FECHA VENCIMIENTO</strong></th>
                                        <th style="border: 1px solid black;"><strong>FORMA DE PAGO</strong></th>
                                    </tr>
                                    <tr>
                                        <td style="border: 1px solid black;">
                                            <span t-field="o.invoice_date"/>
                                        </td>
                                        <td style="border: 1px solid black;">
                                            <span t-field="o.invoice_date_due"/>
                                        </td>
                                        <td style="border: 1px solid black;">
                                            <span t-field="o.invoice_payment_term_id"/>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- Observaciones -->
                        <div class="row mb-2" t-if="o.narration">
                            <div class="col-12" style="font-size: 10px;">
                                <strong>Observaciones: </strong><span t-field="o.narration"/>
                            </div>
                        </div>

                        <!-- Tabla de líneas de factura -->
                        <div class="row">
                            <div class="col-12">
                                <table class="table table-sm table-bordered" style="font-size: 10px;">
                                    <thead>
                                        <tr style="background-color: #f0f0f0;">
                                            <th class="text-center" style="width:5%;">Item</th>
                                            <th class="text-center" style="width:10%;">Código</th>
                                            <th class="text-start" style="width:35%;">Descripción</th>
                                            <th class="text-center" style="width:8%;">UM</th>
                                            <th class="text-center" style="width:7%;">Cant.</th>
                                            <th class="text-end" style="width:13%;">Precio U.</th>
                                            <th class="text-center" style="width:7%;">IVA%</th>
                                            <th class="text-end" style="width:15%;">Total</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-set="line_num" t-value="0"/>
                                        <t t-foreach="o.invoice_line_ids.sorted(key=lambda l: l.sequence)" t-as="line">
                                            <t t-if="line.display_type == 'product'">
                                                <t t-set="line_num" t-value="line_num + 1"/>
                                                <tr>
                                                    <td class="text-center"><span t-out="line_num"/></td>
                                                    <td class="text-center">
                                                        <span t-out="line.product_id.default_code or ''"/>
                                                    </td>
                                                    <td><span t-field="line.name"/></td>
                                                    <td class="text-center">
                                                        <span t-field="line.product_uom_id"/>
                                                    </td>
                                                    <td class="text-center">
                                                        <span t-field="line.quantity"/>
                                                    </td>
                                                    <td class="text-end">
                                                        <span t-field="line.price_unit" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                                    </td>
                                                    <td class="text-center">
                                                        <t t-set="iva_perc" t-value="0"/>
                                                        <t t-foreach="line.tax_ids" t-as="tax">
                                                            <t t-if="tax.amount and tax.amount_type == 'percent' and tax.amount > 0">
                                                                <t t-set="iva_perc" t-value="int(tax.amount)"/>
                                                            </t>
                                                        </t>
                                                        <span t-out="iva_perc"/>
                                                    </td>
                                                    <td class="text-end">
                                                        <span t-field="line.price_subtotal" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                                    </td>
                                                </tr>
                                            </t>
                                            <t t-if="line.display_type == 'line_section'">
                                                <tr>
                                                    <td colspan="8"><strong><span t-field="line.name"/></strong></td>
                                                </tr>
                                            </t>
                                            <t t-if="line.display_type == 'line_note'">
                                                <tr>
                                                    <td colspan="8" class="text-muted"><span t-field="line.name"/></td>
                                                </tr>
                                            </t>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- Totales, Retenciones -->
                        <div class="row">
                            <div class="col-6">
                                <div style="font-size: 10px;">
                                    <div>Total líneas o ítems: <span t-out="line_num"/></div>
                                </div>
                                <div class="mt-2" style="font-size: 10px;">
                                    <strong>Valor en Letras</strong><br/>
                                    <span t-field="o.total_letras" style="text-transform: uppercase;"/>
                                </div>
                                <!-- Referencias de origen -->
                                <div class="mt-2" style="font-size: 10px;">
                                    <div t-if="o.invoice_origin">
                                        <strong>ORDEN DE COMPRA: </strong>
                                        <span t-field="o.invoice_origin"/>
                                    </div>
                                    <div t-if="o.ref">
                                        <strong>REMISIÓN: </strong>
                                        <span t-field="o.ref"/>
                                    </div>
                                </div>
                            </div>
                            <div class="col-6">
                                <table class="table table-sm table-bordered" style="font-size: 11px;">
                                    <tr>
                                        <th><strong>SUBTOTAL</strong></th>
                                        <td class="text-end">
                                            <span t-field="o.amount_untaxed" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                    </tr>
                                    <!-- Desglose de impuestos -->
                                    <t t-if="o.tax_totals">
                                        <t t-foreach="o.tax_totals.get('groups_by_subtotal', {}).get(list(o.tax_totals.get('groups_by_subtotal', {}).keys())[0] if o.tax_totals.get('groups_by_subtotal') else '', [])" t-as="tax_group">
                                            <tr>
                                                <th><strong><span t-out="tax_group.get('tax_group_name', 'IVA')"/></strong></th>
                                                <td class="text-end">
                                                    <span t-out="tax_group.get('tax_group_amount', 0)" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                                </td>
                                            </tr>
                                        </t>
                                    </t>
                                    <tr>
                                        <th><strong>TOTAL DE LA OPERACIÓN</strong></th>
                                        <td class="text-end">
                                            <strong>
                                                <span t-field="o.amount_total" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                            </strong>
                                        </td>
                                    </tr>
                                    <!-- Retenciones (campos calculados en las líneas de tipo impuesto) -->
                                    <t t-set="retefuente" t-value="0"/>
                                    <t t-set="reteiva" t-value="0"/>
                                    <t t-set="reteica" t-value="0"/>
                                    <t t-foreach="o.line_ids.filtered(lambda l: l.tax_line_id)" t-as="tline">
                                        <t t-if="tline.tax_line_id.amount &lt; 0 and 'fuente' in (tline.tax_line_id.name or '').lower()">
                                            <t t-set="retefuente" t-value="retefuente + abs(tline.amount_currency)"/>
                                        </t>
                                        <t t-if="tline.tax_line_id.amount &lt; 0 and 'reteiva' in (tline.tax_line_id.name or '').lower()">
                                            <t t-set="reteiva" t-value="reteiva + abs(tline.amount_currency)"/>
                                        </t>
                                        <t t-if="tline.tax_line_id.amount &lt; 0 and 'ica' in (tline.tax_line_id.name or '').lower()">
                                            <t t-set="reteica" t-value="reteica + abs(tline.amount_currency)"/>
                                        </t>
                                    </t>
                                    <tr t-if="retefuente">
                                        <th>RETEFUENTE</th>
                                        <td class="text-end">
                                            <span t-out="retefuente" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <th>RETEIVA</th>
                                        <td class="text-end">
                                            <span t-out="reteiva" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                    </tr>
                                    <tr t-if="reteica">
                                        <th>RETEICA</th>
                                        <td class="text-end">
                                            <span t-out="reteica" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <th style="background-color: #e0e0e0;"><strong>TOTAL FACTURA</strong></th>
                                        <td class="text-end" style="background-color: #e0e0e0;">
                                            <strong>
                                                <span t-out="o.amount_total - retefuente - reteiva - reteica" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                            </strong>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- Información bancaria y garantías -->
                        <div class="row mt-2" style="font-size: 9px;">
                            <div class="col-6">
                                <div class="border p-2">
                                    <div>Esta factura se asimila en todos sus efectos a la letra de cambio según artículo 774 del Código de Comercio.El incumplimiento en el pago de esta factura en la fecha de vencimiento generará interés de mora a la tasa mas alta autorizada por la Ley</div>
                                </div>
                                <div class="mt-1" t-if="o.company_id.account_opening_move_id">
                                    <strong>Favor consignar en las cuentas:</strong><br/>
                                    <!-- Datos bancarios se toman de la configuración de la empresa -->
                                </div>
                                <div class="mt-1" t-if="o.company_id.website">
                                    <strong>Garantias: </strong><span t-field="o.company_id.website"/>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="border p-2 text-center">
                                    <strong>Representación Gráfica de la Factura de Venta Electrónica</strong><br/>
                                    <div class="mt-1">
                                        <strong>Fecha y Hora de Generación:</strong><br/>
                                        <span t-field="o.create_date" t-options='{"format": "M/d/yyyy h:mm a"}'/>
                                    </div>
                                    <div class="mt-1">
                                        <strong>Medios de pago:</strong><br/>
                                        <span>Instrumento no definido</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Datos de pagos realizados (si aplica) -->
                        <div t-if="print_with_payments">
                            <t t-set="payments_vals" t-value="o.sudo().invoice_payments_widget and o.sudo().invoice_payments_widget.get('content', [])"/>
                            <div t-if="payments_vals" class="row mt-3">
                                <div class="col-12">
                                    <strong>Pagos realizados:</strong>
                                    <table class="table table-sm table-bordered" style="font-size: 10px;">
                                        <tr>
                                            <th>Fecha</th>
                                            <th>Referencia</th>
                                            <th class="text-end">Monto</th>
                                        </tr>
                                        <tr t-foreach="payments_vals" t-as="payment">
                                            <td><span t-out="payment.get('date', '')"/></td>
                                            <td><span t-out="payment.get('ref', '')"/></td>
                                            <td class="text-end"><span t-out="payment.get('amount', 0)" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                                        </tr>
                                    </table>
                                    <div>
                                        <strong>Saldo pendiente: </strong>
                                        <span t-field="o.amount_residual" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>

                    <!-- Para facturas de proveedor / otros tipos, usar el layout estándar -->
                    <t t-if="o.move_type not in ('out_invoice', 'out_refund')">
                        <t t-call="web.external_layout">
                            <t t-set="o" t-value="o.with_context(lang=lang)"/>
                            <div class="page">
                                <h2>
                                    <span t-if="o.move_type == 'in_invoice'">Factura de proveedor</span>
                                    <span t-if="o.move_type == 'in_refund'">Nota Crédito Proveedor</span>
                                    <span t-if="o.name != '/'" t-field="o.name"/>
                                </h2>
                                <div class="row mt-4 mb-4">
                                    <div class="col-auto col-3 mw-100 mb-2" t-if="o.invoice_date">
                                        <strong>Fecha:</strong>
                                        <p class="m-0" t-field="o.invoice_date"/>
                                    </div>
                                    <div class="col-auto col-3 mw-100 mb-2" t-if="o.invoice_origin">
                                        <strong>Origen:</strong>
                                        <p class="m-0" t-field="o.invoice_origin"/>
                                    </div>
                                    <div class="col-auto col-3 mw-100 mb-2" t-if="o.ref">
                                        <strong>Referencia:</strong>
                                        <p class="m-0" t-field="o.ref"/>
                                    </div>
                                </div>
                                <table class="table table-sm table-bordered">
                                    <thead>
                                        <tr>
                                            <th>Descripción</th>
                                            <th class="text-end">Cantidad</th>
                                            <th class="text-end">Precio Unitario</th>
                                            <th>Impuestos</th>
                                            <th class="text-end">Importe</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="o.invoice_line_ids.sorted(key=lambda l: l.sequence)" t-as="line">
                                            <t t-if="line.display_type == 'product'">
                                                <tr>
                                                    <td><span t-field="line.name"/></td>
                                                    <td class="text-end"><span t-field="line.quantity"/> <span t-field="line.product_uom_id"/></td>
                                                    <td class="text-end"><span t-field="line.price_unit"/></td>
                                                    <td><span t-out="', '.join(line.tax_ids.mapped('name'))"/></td>
                                                    <td class="text-end"><span t-field="line.price_subtotal"/></td>
                                                </tr>
                                            </t>
                                        </t>
                                    </tbody>
                                </table>
                                <div class="row">
                                    <div class="col-6 offset-6">
                                        <table class="table table-sm">
                                            <tr>
                                                <th>Monto Libre de Impuestos</th>
                                                <td class="text-end"><span t-field="o.amount_untaxed"/></td>
                                            </tr>
                                            <tr>
                                                <th>Impuestos</th>
                                                <td class="text-end"><span t-field="o.amount_tax"/></td>
                                            </tr>
                                            <tr class="border-top">
                                                <th><strong>Total</strong></th>
                                                <td class="text-end"><strong><span t-field="o.amount_total"/></strong></td>
                                            </tr>
                                        </table>
                                    </div>
                                </div>
                                <div t-if="o.invoice_payment_term_id" class="mt-2">
                                    <strong>Plazo de pago: </strong><span t-field="o.invoice_payment_term_id"/>
                                </div>
                            </div>
                        </t>
                    </t>
                </div>
            </t>
        </xpath>
    </template>

</odoo>
<!-- vim:expandtab:smartindent:tabstop=4:softtabstop=4:shiftwidth=4-->
